+int CONNECTIVITY_DATA::FlushDeferredRatsnest() const
+{
+    // Rebuilding mutates m_nets and submits work to the KiCad thread pool.  All current
+    // readers run on the main thread (GUI tools, DRC providers, API tasks dispatched via wx
+    // events); a reader inside a pool task would risk a nested-pool deadlock and races.
+    wxASSERT_MSG( wxIsMainThread(), wxS( "deferred ratsnest flushed off the main thread" ) );
+
+    if( !wxIsMainThread() )
+        wxLogTrace( wxT( "CN" ), wxT( "FlushDeferredRatsnest called off the main thread" ) );
+
+    CONNECTIVITY_DATA* self = const_cast<CONNECTIVITY_DATA*>( this );
+    std::vector<int>   nets;
+
+    {
+        std::lock_guard<std::mutex> guard( m_pendingRatsnestMutex );
+
+        if( m_pendingRatsnestNets.empty() )
+            return 0;
+
+        nets.assign( m_pendingRatsnestNets.begin(), m_pendingRatsnestNets.end() );
+        self->m_pendingRatsnestNets.clear();
+    }
+
+    // A reader may run in the middle of a commit, between marking nets dirty and the commit's
+    // RecalculateRatsnest.  Those flags must survive (incremental propagation relies on them),
+    // so rebuild with only the pending nets dirty and restore the rest afterwards.
+    std::vector<bool> saved = m_connAlgo->GetDirtyNets();
+    std::vector<bool> onlyPending( std::max<size_t>( saved.size(), nets.back() + 1 ), false );
+
+    for( int net : nets )
+        onlyPending[net] = true;
+
+    m_connAlgo->SetDirtyNets( std::move( onlyPending ) );
+    self->rebuildDirtyRatsnest( false );
+    m_connAlgo->SetDirtyNets( std::move( saved ) );
+    self->applyRatsnestExclusions( &nets );
+
+    {
+        std::lock_guard<std::mutex> guard( m_pendingRatsnestMutex );
+        self->m_hasPendingRatsnest.store( !m_pendingRatsnestNets.empty(), std::memory_order_release );
+    }
+
+    return static_cast<int>( nets.size() );
+}
