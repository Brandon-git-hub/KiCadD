+void CONNECTIVITY_DATA::RunOnUnconnectedEdgesNoFlush(
+        const std::function<bool( int aNet, const CN_EDGE& )>& aFunc ) const
+{
+    for( size_t net = 0; net < m_nets.size(); ++net )
+    {
+        const RN_NET* rnNet = m_nets[net];
+
+        if( !rnNet )
+            continue;
+
+        for( const CN_EDGE& edge : rnNet->GetEdges() )
+        {
+            if( !aFunc( static_cast<int>( net ), edge ) )
+                return;
+        }
+    }
+}
+
+
+unsigned int CONNECTIVITY_DATA::GetUnconnectedCountNoFlush( bool aVisibleOnly ) const
+{
+    unsigned int unconnected = 0;
+
+    for( RN_NET* net : m_nets )
+    {
+        if( !net )
+            continue;
+
+        for( const CN_EDGE& edge : net->GetEdges() )
+        {
+            if( edge.IsVisible() || !aVisibleOnly )
+                ++unconnected;
+        }
+    }
+
+    return unconnected;
+}
