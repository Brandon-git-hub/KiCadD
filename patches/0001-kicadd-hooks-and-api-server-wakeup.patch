+
+void CONNECTIVITY_DATA::applyRatsnestExclusions( const std::vector<int>* aNets )
+{
+    auto applyNet =
+            [&]( RN_NET* aNet )
+            {
+                if( !aNet )
+                    return;
+
+                for( CN_EDGE& edge : aNet->GetEdges() )
+                {
+                    if( edge.GetSourceNode() && edge.GetTargetNode() && !edge.GetSourceNode()->Dirty()
+                        && !edge.GetTargetNode()->Dirty() )
+                    {
+                        std::pair<KIID, KIID> ids = { edge.GetSourceNode()->Parent()->m_Uuid,
+                                                      edge.GetTargetNode()->Parent()->m_Uuid };
+
+                        edge.SetVisible( m_ratsnestExclusions.count( ids ) == 0 );
+                    }
+                }
+            };
+
+    if( aNets )
+    {
+        for( int net : *aNets )
+        {
+            if( net >= 0 && net < (int) m_nets.size() )
+                applyNet( m_nets[net] );
+        }
+    }
+    else
+    {
+        for( RN_NET* net : m_nets )
+            applyNet( net );
+    }
+}
