+void CONNECTIVITY_DATA::SetRatsnestExclusions( std::set<std::pair<KIID, KIID>> aExclusions )
+{
+    m_ratsnestExclusions = std::move( aExclusions );
+    applyRatsnestExclusions( nullptr );
+}
+
+
+void CONNECTIVITY_DATA::applyRatsnestExclusions( const std::vector<int>* aNets )
+{
+    auto applyNet =
+            [&]( RN_NET* aNet )
+            {
+                if( !aNet )
+                    return;
+
+                for( CN_EDGE& edge : aNet->GetEdges() )
+                {
+                    if( edge.GetSourceNode() && edge.GetTargetNode() && !edge.GetSourceNode()->Dirty()
+                        && !edge.GetTargetNode()->Dirty() )
+                    {
+                        std::pair<KIID, KIID> ids = { edge.GetSourceNode()->Parent()->m_Uuid,
+                                                      edge.GetTargetNode()->Parent()->m_Uuid };
+
+                        edge.SetVisible( m_ratsnestExclusions.count( ids ) == 0 );
+                    }
+                }
+            };
+
+    if( aNets )
+    {
+        for( int net : *aNets )
+        {
+            if( net >= 0 && net < (int) m_nets.size() )
+                applyNet( m_nets[net] );
+        }
+    }
+    else
+    {
+        for( RN_NET* net : m_nets )
+            applyNet( net );
+    }
+}
+
+
+std::vector<int> CONNECTIVITY_DATA::GetPendingRatsnestNets() const
+{
+    std::lock_guard<std::mutex> guard( m_pendingRatsnestMutex );
+    return std::vector<int>( m_pendingRatsnestNets.begin(), m_pendingRatsnestNets.end() );
+}
